# 本地开发环境变量 —— 复制为 .dev.vars (已 gitignore) 后填入真实值
# 部署到 Cloudflare 时用: wrangler secret put OPENAI_API_KEY

# 必填: API Key (DeepSeek 兼容 OpenAI 协议)
OPENAI_API_KEY=sk-xxxxxxxx

# 可选: 覆盖 wrangler.jsonc 里的默认值
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# —— 手机号注册 (腾讯云短信 + JWT) ——
# 部署到 Cloudflare 时各自: wrangler secret put <NAME>
# 本地全部留空也可联调: /api/sms/send 会走 dev 兜底, 把验证码随响应返回而不真正发短信。
# 腾讯云凭证 (CAM)
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# 短信应用 / 签名 / 验证码模板 (模板需为单参数 {1} = 验证码)
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# JWT 签名密钥 (注册成功后下发会话 Cookie 用)
# JWT_SECRET=
# 本地开发标记: 存在时跳过 60s 发送限频, 便于反复联调 (仅本地, 勿进生产)
DEV=1