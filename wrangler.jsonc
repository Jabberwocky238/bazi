{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bazi",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_BASE_URL": "https://api.deepseek.com/v1",
    "OPENAI_MODEL": "deepseek-chat"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "5570fc682b144cefa1f04fa8719fd45d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazi-users",
      "database_id": "e994a5d8-790f-41ac-8b2c-1e667f88d65d"
    }
  ]
}
